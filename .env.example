# Copy to `.env`. Read by Docker Compose and the backend.

APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=base
POSTGRES_PASSWORD=base
POSTGRES_DB=base
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://base:base@localhost:5432/base
TEST_DATABASE_URL=postgresql+psycopg://base:base@localhost:5432/base_test

LLM_MODEL=qwen3:8b
OLLAMA_BASE_URL=http://127.0.0.1:11434
LLM_TEMPERATURE=0
LLM_KNOWLEDGE_CUTOFF=2025-04-01
FUNDAMENTALS_PUBLICATION_DELAY_DAYS=60
RISK_FREE_RATE=0
