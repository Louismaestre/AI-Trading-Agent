# Copy to `.env`. Read by Docker Compose and the backend.

APP_ENV=local
LOG_LEVEL=INFO

POSTGRES_USER=base
POSTGRES_PASSWORD=base
POSTGRES_DB=base
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://base:base@localhost:5432/base
TEST_DATABASE_URL=postgresql+psycopg://base:base@localhost:5432/base_test
